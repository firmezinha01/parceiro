# ==============================================================================
# CONFIGURAÇÃO DO SUPABASE (BANCO DE DADOS & TEMPO REAL)
# Preencha estas variáveis no seu arquivo .env local ou nas Configurações da Vercel
# (Vercel Project -> Settings -> Environment Variables)
# ==============================================================================

# URL da API do seu projeto Supabase (ex: https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=

# Chave Anônima Pública (anon key) do seu projeto Supabase (Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=
